# WhatsApp / Meta
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v22.0

# Knowledge base
KB_NAMESPACE=default
KB_DIR=kb

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Embeddings
EMBED_MODEL=text-embedding-3-small

# Confidence thresholds
CONFIDENCE_HIGH=0.75
CONFIDENCE_MEDIUM=0.55
CONFIDENCE_LOW=0.18
ANSWER_CONFIDENCE_THRESHOLD=0.55

SAFEGUARD_ENABLE=true

# Conversation memory
ENABLE_CONVERSATION_MEMORY=true

# Feature flags
ENABLE_QUERY_REWRITE=true
ENABLE_FIRST_TOUCH_MENU=true

# Ticketing — Excel fallback path (used only if the ticketing tool API below is unreachable)
ENABLE_TICKETING=true
TICKET_FILE_PATH=tickets.xlsx

# Ticketing tool integration — main Flask app's base URL and the shared
# secret also set there as BD_SUPPORT_API_KEY.
MAIN_APP_BASE_URL=
BD_SUPPORT_API_KEY=
