# Core
SECRET_KEY=change-this-to-something-random-in-production
DATABASE_URL=sqlite:///database.db

# Initial superadmin password (set before first run; omit to auto-generate a random one)
SUPERADMIN_PASSWORD=

# Email (SMTP outbound)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=admin@yourdomain.com

# API key (used by internal automation endpoints)
API_KEY=change-this-api-key-in-production

# Shared rate-limiter storage - only needed once you run more than one worker
# process. Leave blank to keep in-memory counters (fine for a single worker).
REDIS_URL=

# WhatsApp — Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=change-this-verify-token-in-production
WHATSAPP_API_VERSION=v18.0

# WhatsApp — Twilio (alternative provider)
WA_PROVIDER=meta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886

# Email inbound — IMAP polling
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_KEY=change-imap-key-in-production

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-telegram-secret-in-production

# Slack
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# BDSupport - standalone WhatsApp bot service (Bangladesh). Same key must be set
# in BDSupport's own .env as BD_SUPPORT_API_KEY. BASE_URL is BDSupport's public URL.
BD_SUPPORT_API_KEY=change-this-bdsupport-key-in-production
BD_SUPPORT_BASE_URL=

# Translation
TRANSLATE_API_KEY=
TRANSLATE_PROVIDER=google
LIBRETRANSLATE_URL=http://localhost:5000

# Widget CORS (restrict to your domains in production, e.g. https://yourapp.com)
WIDGET_ALLOWED_ORIGINS=*

# SSO - Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
# Authorized redirect URI: <your-app-url>/login/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSO - Microsoft / Outlook (Azure Portal > Entra ID > App registrations > New registration)
# Redirect URI (Web): <your-app-url>/login/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# AI-assisted "Ask AI" support widget touchpoint (leave blank to fall back to a
# simple guided intake with no live AI calls)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp quick-link shown on the support widget (wa.me format: country code + number, no +)
SUPPORT_WHATSAPP_NUMBER=254705091683
